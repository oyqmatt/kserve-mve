{
  "name": "MVE_container_kserve",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  
  // Set to the user explicitly built in the Dockerfile
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,
  
  "features": {
    // Allows seamless integration with host clusters like Kind/Minikube
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  
  "runArgs": [
    "--gpus",
    "all"
  ],
  "hostRequirements": {
    "gpu": true
  },
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.datawrangler",
        "charliermarsh.ruff"
      ]
    }
  },
  
  // Executed as the 'vscode' user. Sudo works safely now.
  "postCreateCommand": "pip install --no-cache-dir sentence-transformers kserve torchvision peft"
}
